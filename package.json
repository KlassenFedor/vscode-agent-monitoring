{
  "name": "agent-monitor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.10"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run bundle --workspace=agent-monitor",
    "clean": "tsc -b --clean",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --pretty && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:proto": "vitest run packages/protocol"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^3.19.0",
    "prettier": "^3.9.6",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^2.0.0"
  }
}
