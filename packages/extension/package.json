{
  "name": "agent-monitor",
  "displayName": "Agent Monitor",
  "description": "Watch long-running AI coding sessions while they run, and comment without interrupting them.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "//publisher": "Placeholder until a Marketplace publisher exists. `vsce package` is happy with any value; `vsce publish` is not, and must not be run before this is the real one.",
  "publisher": "agent-monitor",
  "repository": {
    "type": "git",
    "url": "https://github.com/KlassenFedor/vscode-agent-monitoring.git"
  },
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20.10"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude code",
    "codex",
    "agent",
    "monitoring",
    "mcp"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/bundle.mjs",
    "bundle": "node scripts/bundle.mjs",
    "icon": "node scripts/icon.mjs",
    "package": "npm run build && vsce package --no-dependencies --out ../../agent-monitor.vsix",
    "reinstall": "npm run package && code --install-extension ../../agent-monitor.vsix --force",
    "test:host": "npm run build && node scripts/host-setup.mjs && tsc -p tsconfig.host.json && vscode-test"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentMonitor",
          "title": "Agent Monitor",
          "icon": "resources/pulse.svg"
        }
      ]
    },
    "views": {
      "agentMonitor": [
        {
          "id": "agentMonitor.sessions",
          "name": "Sessions"
        }
      ]
    },
    "commands": [
      {
        "command": "agentMonitor.openSession",
        "title": "Agent Monitor: Open Session Panel"
      },
      {
        "command": "agentMonitor.setupWorkspace",
        "title": "Agent Monitor: Set Up Workspace",
        "icon": "$(tools)"
      },
      {
        "command": "agentMonitor.comment",
        "title": "Agent Monitor: Comment on the Running Session"
      },
      {
        "command": "agentMonitor.refresh",
        "title": "Agent Monitor: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "agentMonitor.stopSession",
        "title": "Agent Monitor: Stop and Wait",
        "icon": "$(debug-pause)"
      },
      {
        "command": "agentMonitor.openTranscript",
        "title": "Agent Monitor: Open Transcript"
      },
      {
        "command": "agentMonitor.archiveSession",
        "title": "Agent Monitor: Archive Session",
        "icon": "$(archive)"
      },
      {
        "command": "agentMonitor.unarchiveSession",
        "title": "Agent Monitor: Restore Session",
        "icon": "$(history)"
      },
      {
        "command": "agentMonitor.deleteSession",
        "title": "Agent Monitor: Delete Session",
        "icon": "$(trash)"
      },
      {
        "command": "agentMonitor.dismissSession",
        "title": "Agent Monitor: Dismiss Session",
        "icon": "$(eye-closed)"
      },
      {
        "command": "agentMonitor.showDismissedSessions",
        "title": "Agent Monitor: Show Dismissed Sessions",
        "icon": "$(eye)"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "agentMonitor.openSession",
          "when": "view == agentMonitor.sessions && viewItem =~ /agentMonitor\\.(session|archivedSession)/",
          "group": "navigation@1"
        },
        {
          "command": "agentMonitor.comment",
          "when": "view == agentMonitor.sessions && viewItem =~ /agentMonitor\\.(session|archivedSession)/",
          "group": "navigation@2"
        },
        {
          "command": "agentMonitor.stopSession",
          "when": "view == agentMonitor.sessions && viewItem =~ /agentMonitor\\.(session|archivedSession)/",
          "group": "navigation@3"
        },
        {
          "command": "agentMonitor.openTranscript",
          "when": "view == agentMonitor.sessions && viewItem =~ /agentMonitor\\.(session|archivedSession|passiveSession)/",
          "group": "other@1"
        },
        {
          "command": "agentMonitor.setupWorkspace",
          "when": "view == agentMonitor.sessions && viewItem == agentMonitor.passiveSession",
          "group": "other@2"
        },
        {
          "command": "agentMonitor.archiveSession",
          "when": "view == agentMonitor.sessions && viewItem == agentMonitor.session",
          "group": "inline@1"
        },
        {
          "command": "agentMonitor.unarchiveSession",
          "when": "view == agentMonitor.sessions && viewItem == agentMonitor.archivedSession",
          "group": "inline@1"
        },
        {
          "command": "agentMonitor.deleteSession",
          "when": "view == agentMonitor.sessions && viewItem =~ /agentMonitor\\.(session|archivedSession)/",
          "group": "inline@2"
        },
        {
          "command": "agentMonitor.archiveSession",
          "when": "view == agentMonitor.sessions && viewItem == agentMonitor.session",
          "group": "manage@1"
        },
        {
          "command": "agentMonitor.unarchiveSession",
          "when": "view == agentMonitor.sessions && viewItem == agentMonitor.archivedSession",
          "group": "manage@1"
        },
        {
          "command": "agentMonitor.deleteSession",
          "when": "view == agentMonitor.sessions && viewItem =~ /agentMonitor\\.(session|archivedSession)/",
          "group": "manage@2"
        },
        {
          "command": "agentMonitor.dismissSession",
          "when": "view == agentMonitor.sessions && viewItem == agentMonitor.passiveSession",
          "group": "inline@1"
        },
        {
          "command": "agentMonitor.dismissSession",
          "when": "view == agentMonitor.sessions && viewItem == agentMonitor.passiveSession",
          "group": "manage@1"
        }
      ],
      "view/title": [
        {
          "command": "agentMonitor.setupWorkspace",
          "when": "view == agentMonitor.sessions",
          "group": "navigation@1"
        },
        {
          "command": "agentMonitor.refresh",
          "when": "view == agentMonitor.sessions",
          "group": "navigation@2"
        },
        {
          "command": "agentMonitor.showDismissedSessions",
          "when": "view == agentMonitor.sessions && agentMonitor.hasDismissed",
          "group": "manage@1"
        }
      ],
      "commandPalette": [
        {
          "command": "agentMonitor.dismissSession",
          "when": "false"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentMonitor.sessions",
        "when": "!agentMonitor.configured",
        "contents": "This workspace is not wired up yet.\n\nSetup points Claude Code and Codex at this panel: milestones as they happen, artefacts you can open, and comments that reach the agent while it works.\n[Set Up Workspace](command:agentMonitor.setupWorkspace)\nIt merges into whatever configuration you already have, and is safe to run again."
      },
      {
        "view": "agentMonitor.sessions",
        "when": "agentMonitor.configured",
        "contents": "No agent sessions yet.\n\nStart Claude Code or Codex in this workspace. A session appears here as soon as the agent reports its first milestone.\n[Run Setup Again](command:agentMonitor.setupWorkspace)"
      }
    ],
    "configuration": {
      "title": "Agent Monitor",
      "properties": {
        "agentMonitor.pollIntervalMs": {
          "type": "number",
          "default": 1000,
          "description": "How often to re-read the session files when the file watcher misses a change."
        },
        "agentMonitor.staleAfterMs": {
          "type": "number",
          "default": 600000,
          "description": "A session with no activity for this long is shown as stale."
        },
        "agentMonitor.keepSessionsForDays": {
          "type": "number",
          "default": 14,
          "description": "Delete session directories in .agent-monitor/ that have been untouched for this many days. Set to 0 to keep everything."
        },
        "agentMonitor.notifyOnQuestion": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when an agent asks a question and is waiting for you."
        },
        "agentMonitor.sessionLabelExtras": {
          "type": "array",
          "default": [],
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "agent",
              "created",
              "updated"
            ],
            "enumDescriptions": [
              "The agent that owns the session, as [claude] or [codex].",
              "When the session started.",
              "When the session was last active."
            ]
          },
          "markdownDescription": "What to show in front of a session title in the Sessions list. Pick any combination, including none; they are always shown in this order: agent, created, updated. Times are `HH:MM`, or `DD.MM HH:MM` for another day. Empty (the default) shows the title on its own."
        }
      }
    }
  },
  "dependencies": {
    "@agent-monitor/protocol": "0.0.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.23.0",
    "mocha": "^10.8.2"
  }
}
